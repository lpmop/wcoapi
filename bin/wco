#!/usr/bin/env php
<?php

declare(strict_types=1);

use WcoApi\Command\AdministratorsCommand;
use WcoApi\Command\AdministratorsCreateCommand;
use WcoApi\Command\CallsCommand;
use WcoApi\Command\DownloadCommand;
use WcoApi\Command\GetCommand;
use WcoApi\Command\ProfilesAddCommand;
use WcoApi\Command\ProfilesCommand;
use WcoApi\Command\ProfilesRemoveCommand;
use WcoApi\Command\ProfilesUseCommand;
use WcoApi\Command\UsersCommand;
use WcoApi\Command\WhoamiCommand;
use WcoApi\DownloadLedger;
use WcoApi\Persistence\LedgerDownloadTracker;
use WcoApi\Storage\LocalDirectoryStorage;
use WcoApi\WcoConfig;
use WcoApi\WcoProfilesFactory;
use Symfony\Component\Console\Application;
use Symfony\Component\Dotenv\Dotenv;

$autoloadCandidates = [
    dirname(__DIR__, 3) . '/autoload.php',
    dirname(__DIR__, 2) . '/vendor/autoload.php',
    dirname(__DIR__) . '/vendor/autoload.php',
];

$loaded = false;
$autoloadFile = null;
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        $autoloadFile = $autoload;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Brak vendor/autoload.php — uruchom composer install w projekcie hosta.\n");
    exit(1);
}

$vendorDir = dirname($autoloadFile);
$appDir = str_ends_with(str_replace('\\', '/', $vendorDir), '/vendor')
    ? dirname($vendorDir)
    : dirname(__DIR__, 2);

if (is_file($appDir . '/.env') && class_exists(Dotenv::class)) {
    (new Dotenv())->bootEnv($appDir . '/.env');
}

$env = $_ENV + $_SERVER;
$config = WcoConfig::fromEnv($env);
$profiles = WcoProfilesFactory::create(
    $appDir,
    (string) ($env['WCO_PROFILES_FILE'] ?? ''),
    (string) ($env['WCO_PROFILE'] ?? ''),
);

$downloadDir = $config->downloadDir;
if (!preg_match('#^(?:[a-zA-Z]:)?[/\\\\]#', $downloadDir)) {
    $downloadDir = $appDir . '/' . ltrim(str_replace('\\', '/', $downloadDir), '/');
}
$storage = new LocalDirectoryStorage($downloadDir);
$tracker = new LedgerDownloadTracker(new DownloadLedger($storage->location()));

$app = new Application('wco-api', '0.1.0');
foreach ([
    new CallsCommand($config, $profiles, $storage, $tracker),
    new DownloadCommand($config, $profiles, $storage, $tracker),
    new WhoamiCommand($config, $profiles),
    new UsersCommand($config, $profiles),
    new AdministratorsCommand($config, $profiles),
    new AdministratorsCreateCommand($config, $profiles),
    new GetCommand($config, $profiles),
    new ProfilesCommand($profiles, $config),
    new ProfilesAddCommand($profiles, $config),
    new ProfilesUseCommand($profiles),
    new ProfilesRemoveCommand($profiles),
] as $command) {
    $app->add($command);
}
$app->run();
